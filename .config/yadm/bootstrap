#!/bin/bash

############################
#
# Install all the basic packages to get rollin'
#
################################

# symlink YADM alternate files into place
if command -v yadm >/dev/null 2>&1; then
  yadm alt
fi

# Step 0: get mad permissions
export CURRENT_USER=$(whoami)
echo "Let's setup $CURRENT_USER"
sudo -v -u $CURRENT_USER

system_type=$(uname -s)

# OSX Setup Steps
if [ "$system_type" = "Darwin" ]; then
  # Step 1: ensure homebrew is installed
  if command -v brew &> /dev/null
  then 
    echo 'homebrew already installed 🍺'
  else
    echo 'homebrew needs to be installed...'
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

    # Add brew to zsh path
    echo '# set PATH, MANPATH, etc. for Homebrew.' >> ~/.zshrc
    echo export PATH=$PATH:/opt/homebrew/bin >> ~/.zshrc

    echo 'brew success! 🍻'
  fi

  # makes sure `brew` is accessible in $PATH
  source ~/.zshrc

  # Step 2: install fish
  if command -v fish &> /dev/null
  then
    echo 'fish shell already installed 🎣'
  else
    echo '🐡 installing fish...'
    brew install fish
  fi
fi

# Linux setup steps -- Arch specificially, may need to use a different check if 
# we ever install a different Linux Distro
if [ "$system_type" = "Linux" ]; then
  # Step 1: install fish
  sudo pacman -S --needed fish
fi

# Ensure fish is default shell and can execute commands
if ! command -v fish &> /dev/null; then
  echo '💣 something has gone terribly wrong...check "fish" exists on the $PATH'
  exit 1
fi

export FISH_BIN=$(which fish)
# Add fish to list of acceptable shells
# first check that it hasn't already been added:
if grep -Fxq $FISH_BIN /etc/shells
then
  echo "🎣 Fish already an accepted shell"
else
  echo "adding Fish to /etc/shells 🎣"
  echo $FISH_BIN | sudo tee -a /etc/shells
fi

# make fish the default login shell
sudo chsh -s $FISH_BIN $CURRENT_USER

# Mise (package manager)
if ! command -v mise &> /dev/null; then
  # Installs mise and adds activation to ~/.config/fish/config.fish
  curl https://mise.run/fish | sh
  # NOTE: no need to source config.fish here -- yadm has already restored it,
  # and it's fish syntax which bash can't parse anyway
fi

if ! fish -c "omf -v" &> /dev/null; then
  echo 'installing oh-my-fish...'
  # --noninteractive: the installer ends by exec'ing an interactive fish shell,
  # which would silently halt this script. Never pipe it into fish directly.
  curl -fsSL https://raw.githubusercontent.com/oh-my-fish/oh-my-fish/master/bin/install -o /tmp/omf-install.fish
  fish /tmp/omf-install.fish --noninteractive
fi

# install "pure" theme and ensure it's set
fish -c "omf install"

if [ "$system_type" = "Darwin" ]; then
  # execute remaining setup scripts in fish
  fish <<FISH_SCRIPT
  # ensure hombrew is in the $PATH
  fish_add_path /opt/homebrew/bin

  $(pwd)/.config/yadm/mac_install.fish
FISH_SCRIPT
fi

if [[ "$system_type" == "Linux" ]]; then
  # Install any additional packages we want/need
  sudo pacman -S --needed neovim ripgrep fd lazygit zellij ttf-hack-nerd yazi ollama 1password 1password-cli

  # Omarchy -> Yazi theme sync
  curl -fsSL https://raw.githubusercontent.com/joaofelipegalvao/omarchy-yazi/main/scripts/omarchy-yazi-install.sh | bash

  echo "Open 1Password and authenticate with your account."
  echo "Also go to Settings... -> Developer and 'Integrate with 1Password CLI"
  read -rp "Press Enter when you're ready to continue..."

  # AUR packages
  # remove conflicting
  # yay -Ry cbonsai-git
  # add desired
  yay -Sy --needed --noconfirm cbonsai ripdrag

  # Default terminal: ghostty (installs package + default config + sets xdg-terminals.list)
  omarchy install terminal ghostty

  # Default coding agent: claude. Write the preference file directly --
  # `omarchy default agent claude` exec's the agent TUI, which would hijack this script.
  mkdir -p "$HOME/.config/omarchy/defaults"
  echo claude > "$HOME/.config/omarchy/defaults/agent"
  mise where claude &>/dev/null || mise install -y claude
fi

cd "$HOME"
echo " 󰊢 init LazyVim submodule"
NVIM_DIR="$HOME/.config/nvim"

# Is .config/nvim recorded as a submodule (gitlink) in the yadm repo?
nvim_mode=$(yadm ls-files -s -- .config/nvim 2>/dev/null | awk '{print $1}')

# Is the working tree a proper submodule checkout? (.git is a file, not a dir)
is_checkout=false
[ -f "$NVIM_DIR/.git" ] && is_checkout=true

if [ "$nvim_mode" = "160000" ] && $is_checkout; then
  echo "nvim already a yadm submodule"
else
  # back up any existing content (skip if dir is absent or empty)
  if [ -d "$NVIM_DIR" ] && [ -n "$(ls -A "$NVIM_DIR")" ]; then
    echo "backing up existing nvim config to nvim-bak"
    rm -rf "$HOME/.config/nvim-bak"
    mv "$NVIM_DIR" "$HOME/.config/nvim-bak"
  fi
fi
yadm submodule update --recursive --init

if [[ "$system_type" == "Linux" ]]; then
  echo "Refreshing Hyprland session to pickup these changes and set default shell to be 'fish'"
  if command -v hyprctl >/dev/null 2>&1; then
    hyprctl reload
  fi
  # chsh only takes effect at next login; reboot so $SHELL is fish everywhere
  echo "Setup complete! Rebooting in 5 seconds to make 'fish' the login shell (Ctrl+C to cancel)..."
  sleep 5
  omarchy system reboot
fi

